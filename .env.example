# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real credentials.

# --- Supabase (Dashboard > Project Settings > API) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://lriviskeevpkljbhtxhy.supabase.co

# Publishable / anon key (starts with "sb_publishable_" or "eyJ...").
# NEVER use the service_role / secret key here — this is client-side code.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudinary (Dashboard > API Keys / Settings > Upload) ---
# Cloud name from the Cloudinary console home page
VITE_CLOUDINARY_CLOUD_NAME=

# An UNSIGNED upload preset name (Settings > Upload > Upload presets).
# The app uploads images to ezfinance/transactions and ezfinance/profile.
VITE_CLOUDINARY_UPLOAD_PRESET=
